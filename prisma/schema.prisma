generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum ProjectColors {
  Blue
  Green
  Orange
  Red
  Purple
  Cyan
}

enum ProjectIcons {
  Zap
  Rocket
  Palette
  RefreshCw
  Smartphone
  Globe
  Shield
  ChartColumn
}

enum SprintStatus {
  Planning
  Delayed
  Active
  Completed
}

enum TaskStatus {
  Todo
  InProgress
  InReview
  Completed
}

enum TaskPriorities {
  Low
  Medium
  High
  Critical
}

enum ProjectRoles {
  Owner
  Admin
  Member
}

enum ProjectStatus {
  Active
  Paused
  Completed
  Cancelled
}



model User {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId

  name          String
  image         String?
  email         String   @unique
  mainPosition  String?

  createdAt     DateTime @default(now())
  emailVerified DateTime?


  accounts Account[]
  sessions Session[]


  // Projetos que participa
  memberships ProjectMember[]


  tasks    Task[]
}



model Project {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId

  name        String
  description String
  url         String   @unique

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  status   ProjectStatus

  color ProjectColors
  icon  ProjectIcons


  members ProjectMember[]

  tasks   Task[]
  sprints Sprint[]
}



model ProjectMember {
  id String @id @default(auto()) @map("_id") @db.ObjectId


  role ProjectRoles @default(Member)


  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id])


  projectId String @db.ObjectId
  project   Project @relation(fields: [projectId], references: [id])


  @@unique([userId, projectId])
}



model Task {
  id String @id @default(auto()) @map("_id") @db.ObjectId


  points      Int
  description String

  status   TaskStatus
  priority TaskPriorities

  deadline DateTime

  tags String[]


  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt


  userId String? @db.ObjectId
  user   User? @relation(fields: [userId], references: [id])


  sprintId String? @db.ObjectId
  sprint   Sprint? @relation(fields: [sprintId], references: [id])


  projectId String @db.ObjectId
  project   Project @relation(fields: [projectId], references: [id])


}



model Sprint {
  id String @id @default(auto()) @map("_id") @db.ObjectId


  name      String
  objective String


  situation SprintStatus


  startAt DateTime
  endAt   DateTime


  tasks Task[]


  projectId String @db.ObjectId
  project   Project @relation(fields: [projectId], references: [id])
}

model Account {
  id                String @id @default(auto()) @map("_id") @db.ObjectId
  userId            String @db.ObjectId

  type              String
  provider          String
  providerAccountId String

  access_token      String?
  refresh_token     String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  sessionToken String   @unique
  userId       String   @db.ObjectId
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
